# ============================================================================
# OneRole Enterprise API Server — Production Dockerfile
# Multi-stage minimal footprint, non-root hardened runtime
# ============================================================================

FROM golang:1.24-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /app/server main.go

# ----------------------------------------------------------------------------
# Minimal Production Distroless/Alpine Runtime
# ----------------------------------------------------------------------------
FROM alpine:3.20

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata curl && \
    addgroup -g 1001 -S onerole && \
    adduser -u 1001 -S onerole -G onerole

COPY --from=builder /app/server /app/server
COPY company.json /app/company.json

USER onerole

ENV PORT=8088
EXPOSE 8088

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD curl -f http://localhost:8088/api/v1/healthz || exit 1

ENTRYPOINT ["/app/server", "all"]
